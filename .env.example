# Django reads these values from the process environment.
# Replace placeholders with local-only values; never commit real credentials.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Reserved for the frontend when an API integration is introduced.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
