# =============================================================================
# School Management System - Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Mode
# -----------------------------------------------------------------------------
ENVIRONMENT=development
NODE_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development

# Deployment mode: "cloud" or "school-server"
DEPLOYMENT_MODE=cloud

# School identifier (required for school-server mode)
SCHOOL_ID=school-001
SCHOOL_NAME=

# -----------------------------------------------------------------------------
# Next.js / Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_DEPLOYMENT_MODE=cloud
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production-please-generate-a-random-secret

# -----------------------------------------------------------------------------
# Django / Backend
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production-please-generate-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGIN_WHITELIST=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edukit
POSTGRES_USER=edukit
POSTGRES_PASSWORD=change-me-postgres-password

# School-server specific PostgreSQL (different from cloud)
SCHOOL_POSTGRES_HOST=localhost
SCHOOL_POSTGRES_PORT=5432
SCHOOL_POSTGRES_DB=edukit_school
SCHOOL_POSTGRES_USER=edukit
SCHOOL_POSTGRES_PASSWORD=change-me-school-postgres-password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# -----------------------------------------------------------------------------
# Object Storage (S3-compatible) - Cloud
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_STORAGE_BUCKET_NAME=edukit
S3_REGION=us-east-1
S3_USE_SSL=True

# Local file storage - School server
LOCAL_STORAGE_ROOT=/var/lib/edukit/media
LOCAL_STORAGE_URL=/media/

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

PASSWORD_MIN_LENGTH=8
LOGIN_ATTEMPTS_BEFORE_LOCKOUT=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# -----------------------------------------------------------------------------
# Synchronization Engine
# -----------------------------------------------------------------------------
SYNC_ENABLED=True
SYNC_PUSH_INTERVAL_SECONDS=60
SYNC_PULL_INTERVAL_SECONDS=120
SYNC_BATCH_SIZE=100
SYNC_MAX_RETRIES=5
SYNC_RETRY_BACKOFF_SECONDS=5

# Cloud sync endpoint (used by school-server)
CLOUD_SYNC_API_URL=https://cloud.example.com/api/v1/sync
CLOUD_SYNC_API_KEY=change-me-cloud-sync-api-key

# -----------------------------------------------------------------------------
# WebSockets / Django Channels
# -----------------------------------------------------------------------------
CHANNELS_REDIS_HOST=localhost
CHANNELS_REDIS_PORT=6379
CHANNELS_REDIS_DB=3

# -----------------------------------------------------------------------------
# Email / Notifications
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@edukit.local

# SMS (optional)
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

# WhatsApp (optional)
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# -----------------------------------------------------------------------------
# NFC Configuration
# -----------------------------------------------------------------------------
NFC_READER_TIMEOUT_SECONDS=30
NFC_BADGE_ENCRYPTION_KEY=change-me-nfc-encryption-key-32chars

# -----------------------------------------------------------------------------
# Finance / Payment (optional)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=none
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=/var/log/edukit/app.log

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# School Server Specific
# -----------------------------------------------------------------------------
SCHOOL_SERVER_LAN_IP=192.168.1.100
SCHOOL_SERVER_DOMAIN=school.local
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
