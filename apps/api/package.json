{
  "name": "@edukit/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "manage": "python manage.py",
    "migrate": "python manage.py migrate",
    "makemigrations": "python manage.py makemigrations",
    "migrate:all": "python manage.py makemigrations identity permissions audit && python manage.py migrate",
    "runserver": "python manage.py runserver 0.0.0.0:8000",
    "shell": "python manage.py shell",
    "test": "pytest",
    "test:cov": "pytest --cov=apps --cov-report=term --cov-report=html",
    "test:watch": "pytest-watch",
    "check": "python manage.py check && python manage.py check --deploy || true",
    "createsuperuser": "python manage.py createsuperuser",
    "collectstatic": "python manage.py collectstatic --noinput",
    "sync:permissions": "python manage.py sync_permissions",
    "seed": "python manage.py seed_dev_identities",
    "celery:worker": "celery -A config worker -l info",
    "celery:beat": "celery -A config beat -l info"
  }
}
