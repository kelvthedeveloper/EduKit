# 数据库配置
DB_PASSWORD=changeme

# Django 配置
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*

# Redis
REDIS_URL=redis://redis:6379/0

# 应用配置
SCHOOL_NAME=示例学校
SYNC_CLOUD_URL=https://cloud.edukit.example.com
SYNC_SCHOOL_ID=school-001
SYNC_API_KEY=your-sync-api-key-here

# 备份配置
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=./backups
