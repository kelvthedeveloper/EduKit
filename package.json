{
  "name": "school-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @edukit/web dev",
    "dev:api": "pnpm --filter @edukit/api runserver",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @edukit/api migrate",
    "db:migrate:school": "pnpm --filter @edukit/api migrate:school",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:school:up": "docker-compose -f docker-compose.school.yml up -d",
    "docker:school:down": "docker-compose -f docker-compose.school.yml down"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
