{
    "name": "kelvthedeveloper/edukit",
    "description": "A local-network school management system.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "monolog/monolog": "^3.12",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "EduKit\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EduKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {}
    }
}
